# Callback to populate saved partners list and edit dropdown
@callback(
    Output('saved-partners-list-display', 'children'),
    Output('edit-partner-select', 'options'),
    Output('ghosting-partner-select', 'options'), # Update ghosting dropdown too
    Input('partners-data-store', 'data') # Trigger when partners list changes
)
def update_saved_partners_display(partners_list):
    partners_list = partners_list if partners_list else []
    if not partners_list:
        display = html.P("No partners saved yet.")
        options = []
    else:
        display_items = []
        options = []
        for p in partners_list:
             name = p.get('name', f"Partner ID: {p.get('id')}")
             display_items.append(html.Li(name))
             options.append({'label': name, 'value': p.get('id')})
        display = html.Ul(display_items)

    return display, options, options # Same options for both dropdowns

