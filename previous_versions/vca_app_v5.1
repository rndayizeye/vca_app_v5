# == Callback to Save/Update Partner in Main Store ==
@callback(
    Output('partners-data-store', 'data', allow_duplicate=True),
    Output('current-partner-form-store', 'data', allow_duplicate=True), # Clear form on save
    # Also clear the display lists for the partner form
    Output('partner-labs-list', 'children', allow_duplicate=True),
    Output('partner-symptoms-list', 'children', allow_duplicate=True),
    Output('partner-treatments-list', 'children', allow_duplicate=True),
    Output('current-partner-id-display', 'children', allow_duplicate=True),
     # Clear form inputs explicitly
    Output('partner-name', 'value', allow_duplicate=True),
    Output('partner-first-exposure', 'date', allow_duplicate=True),
    Output('partner-last-exposure', 'date', allow_duplicate=True),
    Output('partner-freq-value', 'value', allow_duplicate=True),
    Output('partner-freq-unit', 'value', allow_duplicate=True),
    Output('partner-sex-types', 'value', allow_duplicate=True),
    Output('partner-diagnosis', 'value', allow_duplicate=True),
    # Reset button states for list items might be needed if not clearing store
    Input('save-partner-btn', 'n_clicks'),
    State('current-partner-form-store', 'data'),
    State('partners-data-store', 'data'),
    prevent_initial_call=True
)
def save_or_update_partner(n_clicks, partner_form_data, partners_list):
    if not partner_form_data or not (partner_form_data.get('name') or partner_form_data.get('id')):
        # Don't save if no name/id, maybe show an error?
        # For now, just don't save and don't clear form
         raise dash.exceptions.PreventUpdate

    partners_list = partners_list if partners_list else []
    partner_id = partner_form_data.get('id')

    if partner_id: # Existing partner is being updated
        updated_list = []
        for p in partners_list:
            if p.get('id') == partner_id:
                # Update existing entry with current form data
                 updated_list.append(partner_form_data.copy())
            else:
                 updated_list.append(p)
        partners_list = updated_list
    else: # New partner
        new_id = str(uuid.uuid4()) # Generate a unique ID
        partner_form_data['id'] = new_id
        partners_list.append(partner_form_data.copy())

    # Reset the form store and display lists, clear basic inputs
    return (partners_list, DEFAULT_PARTNER_DATA.copy(),
            None, None, None, # Clear display lists
            "", # Clear ID display
            # Explicitly clear inputs
            None, None, None, None, None, None, None)


